<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.androidcontrol.regression.browser">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />
    <application android:debuggable="true" android:theme="@android:style/Theme.Material.NoActionBar" android:label="Browser regression fixture">
        <activity android:name=".BrowserActivity" android:exported="true" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>
    </application>
</manifest>

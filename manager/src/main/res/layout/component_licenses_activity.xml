<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/CardTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="20sp"
            android:text="@string/component_licences_source_heading"/>
        <TextView style="@style/CardContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/component_licences_scope" />
        <TextView style="@style/CardTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/component_licences_text_heading" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/licence_shizuku" style="@style/CardButton"
            android:layout_width="match_parent" android:layout_marginTop="12dp"
            android:text="@string/component_licence_shizuku"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/licence_appops" style="@style/CardButton"
            android:layout_width="match_parent" android:text="@string/component_licence_appops"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/licence_shizu" style="@style/CardButton"
            android:layout_width="match_parent" android:text="@string/component_licence_shizu"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/licence_scrcpy" style="@style/CardButton"
            android:layout_width="match_parent" android:text="@string/component_licence_scrcpy"/>
        <TextView android:id="@+id/component_licence_links" style="@style/CardContent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
